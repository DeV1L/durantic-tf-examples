<mxfile host="app.diagrams.net" type="device">
  <diagram id="k3s-standalone-argocd" name="k3s-standalone-argocd">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="k3s-standalone-argocd : single-node k3s + ArgoCD (no gateway)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ===== external sources (top) ===== -->
        <mxCell id="ghRepo" value="GitHub : DeV1L/argocd-example-apps&#10;branch irrisketch-demo&#10;nodejs-app-mongodb/apps (app-of-apps)&#10;-&gt; manifests + argocd-extras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="360" height="94" as="geometry" />
        </mxCell>
        <mxCell id="ghcrBoot" value="ghcr.io/dev1l/durantic-k3s-argocd (private)&#10;baked boot image:&#10;k3s + ArgoCD HelmChart + scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="50" width="320" height="94" as="geometry" />
        </mxCell>
        <mxCell id="ghcrApp" value="ghcr.io/dev1l/&#10;argocd-example-nodejs-app-mongodb&#10;:frontend  :backend  (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="50" width="320" height="94" as="geometry" />
        </mxCell>

        <!-- ===== provisioning column (left) ===== -->
        <mxCell id="tf" value="Terraform  (durantic provider)&#10;durantic-tf-examples/k3s-standalone-argocd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cp" value="Durantic Controlplane  (api.demo.durantic.dev)&#10;&#10;creates: mesh 10.62.0.0/24, k3s + ghcr secrets,&#10;ArgoCD repo/branch/path vars,&#10;registry credential, machine role, deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="imgbuild" value="build boot image (manual)&#10;docker build (FROM linux-ubuntu-25.10)&#10;-&gt; docker push (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="360" height="84" as="geometry" />
        </mxCell>

        <!-- ===== the node (zone) ===== -->
        <mxCell id="zNode" value="k3s-argocd-demo  .  51.15.249.37  .  single-node k3s (boots the baked image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=top;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="720" height="570" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="cloud-init (config only)&#10;writes k3s config + registries.yaml + argocd.env, starts k3s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="278" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k3s" value="k3s + Traefik  (baked into the image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="370" width="330" height="40" as="geometry" />

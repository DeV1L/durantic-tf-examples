        <mxCell id="ghcrBoot" value="ghcr.io/dev1l/durantic-k3s-argocd  (private)&#10;baked boot image:&#10;k3s binary + systemd unit&#10;+ ArgoCD HelmChart + bootstrap scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">

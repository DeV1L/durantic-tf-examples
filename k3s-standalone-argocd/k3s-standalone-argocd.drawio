      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="update-app-version" name="Update app version">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a_title" value="Update an app version  (GitOps flow)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a_dev" value="1. Developer edits the app code&#10;nodejs-app-mongodb/src/{frontend | backend}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_build" value="2. docker build + push a NEW tag&#10;ghcr.io/dev1l/argocd-example-nodejs-app-mongodb:frontend-v2  (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="166" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_git" value="3. Bump the image tag in nodejs-app-mongodb/manifests/*.yaml&#10;git commit + push  (branch irrisketch-demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="262" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_argo" value="4. ArgoCD (auto-sync + self-heal)&#10;detects the git change and syncs the Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="358" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_roll" value="5. k3s rolling update of the Deployment&#10;containerd pulls the new image  (registries.yaml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="454" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_done" value="6. App updated  (rolling, no downtime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="550" width="470" height="46" as="geometry" />
        </mxCell>

        <mxCell id="a_note" value="GitOps: change the image TAG and commit the manifest change — ArgoCD syncs from git.&#10;&#10;Rebuilding the same :frontend tag alone won't trigger a sync (no git change)." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="166" width="380" height="152" as="geometry" />
        </mxCell>

        <mxCell id="a_e1" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_dev" target="a_build"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_e2" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_build" target="a_git"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_e3" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_git" target="a_argo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_e4" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_argo" target="a_roll"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a_e5" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_roll" target="a_done"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="update-k3s-server" name="Update k3s server">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k_title" value="Update the k3s version  (single node: rebuild the boot image + re-provision)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="k_bump" value="1. Bump K3S_VERSION in image/Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="470" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k_build" value="2. docker build + push the new boot image&#10;ghcr.io/dev1l/durantic-k3s-argocd  (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="156" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k_reg" value="3. Update the image in the Dashboard&#10;(new tag, or re-pull the :latest tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="252" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k_stop" value="4. Stop apps / back up data&#10;re-provision REIMAGES the node — the mongodb PVC is lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="348" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k_apply" value="5. terraform apply  (bump force_provision)&#10;the node reboots into the new baked image -&gt; fresh k3s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="444" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k_redeploy" value="6. ArgoCD re-deploys the app from git  (app-of-apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="470" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k_verify" value="7. Verify  app :80  +  ArgoCD UI :30080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="626" width="470" height="46" as="geometry" />
        </mxCell>

        <mxCell id="k_note" value="Single-node cluster: there is no in-place / rolling k8s upgrade.&#10;Updating k3s = a new boot image + a full re-provision, which wipes the node — so back up MongoDB / PVC data first." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="156" width="380" height="152" as="geometry" />
        </mxCell>


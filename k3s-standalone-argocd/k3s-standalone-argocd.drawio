        <mxCell id="title" value="k3s-standalone-argocd : single-node k3s + ArgoCD (no gateway)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-10" width="700" height="30" as="geometry" />

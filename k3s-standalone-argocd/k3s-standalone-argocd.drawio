              <mxPoint x="960" y="650" />
              <mxPoint x="960" y="437" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== edges: user access (green) ===== -->
        <mxCell id="e_user_ing" value=":80  (app)" style="endArrow=block;html=1;rounded=0;fontSize=11;strokeColor=#82b366;strokeWidth=2;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_user_argo" value=":30080  (ArgoCD UI)" style="endArrow=block;html=1;rounded=0;fontSize=11;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="argocd">
          <mxGeometry relative="1" as="geometry">

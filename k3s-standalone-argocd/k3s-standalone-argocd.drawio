        <mxCell id="fe" value="frontend (Deployment)&#10;UI + /api reverse proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="408" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="be" value="backend (Deployment)&#10;PDF generator :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="506" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="mongodb (StatefulSet)&#10;+ local-path PVC :27017" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="604" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User / Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="820" width="180" height="52" as="geometry" />
        </mxCell>

        <!-- ===== edges: build / provision ===== -->
        <mxCell id="e_tf_cp" value="terraform apply" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tf" target="cp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_build_reg" value="register image + cred (Dashboard)" style="endArrow=block;html=1;dashed=1;rounded=0;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="imgbuild" target="cp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_build_push" value="build + push (private)" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="imgbuild" target="ghcrBoot">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="585" />
              <mxPoint x="480" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cp_node" value="provision" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cp" target="ci">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="545" y="425" />
              <mxPoint x="545" y="306" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_bootpull" value="pull boot image (cred)" style="endArrow=block;html=1;dashed=1;rounded=0;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ghcrBoot" target="ci">
          <mxGeometry x="-0.5" relative="1" as="geometry" />
        </mxCell>

        <!-- ===== edges: runtime ===== -->
        <mxCell id="e_ci_k3s" value="starts" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="k3s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_k3s_argo" value="auto-deploys ArgoCD" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3s" target="argocd">
          <mxGeometry x="-0.4" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_argo_repo" value="syncs app-of-apps" style="endArrow=block;html=1;dashed=1;rounded=0;fontSize=11;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="argocd" target="ghRepo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="521" />
              <mxPoint x="450" y="97" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_argo_app" value="deploys" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="argocd" target="appNs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_apppull" value="pull app images (registries.yaml)" style="endArrow=block;html=1;dashed=1;rounded=0;fontSize=11;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ghcrApp" target="appNs">
          <mxGeometry x="-0.5" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fe_be" value="/api -&gt; :3000" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe" target="be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_be_mongo" value=":27017" style="endArrow=block;html=1;rounded=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="be" target="mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ing_fe" value="" style="endArrow=block;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ingress" target="fe">
          <mxGeometry relative="1" as="geometry">

    <diagram id="update-app-version" name="Update app version">
        <mxGraphModel dx="735" dy="702" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="a_title" value="Update an app version  (GitOps flow)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="a_dev" value="1. Developer edits the app code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="70" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="a_build" value="2. docker build + push a NEW tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="166" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="a_git" value="3. Bump the image tag in nodejs-app-mongodb/manifests/*.yaml&lt;br&gt;git commit + push&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="262" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="a_argo" value="4. ArgoCD (auto-sync)&lt;br&gt;detects the git change and syncs the Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="358" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="a_roll" value="5. k3s rolling update of the Deployment&lt;br&gt;containerd pulls the new image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="454" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="a_done" value="6. App updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="550" width="470" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="a_e1" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="a_dev" target="a_build" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_e2" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="a_build" target="a_git" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_e3" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="a_git" target="a_argo" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_e4" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="a_argo" target="a_roll" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_e5" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="a_roll" target="a_done" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="update-k3s-server" name="Update k3s server">
        <mxGraphModel dx="735" dy="702" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="k_title" value="Update the k3s version  (single node: rebuild the boot image + re-provision)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="k_bump" value="1. Bump K3S_VERSION in image/Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="70" width="470" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="k_build" value="2. docker build + push the new boot image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="156" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="k_reg" value="3. Image updated by Terraform&#xa;(or use the :latest tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="252" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="k_stop" value="4. Re-provision reimages the SYSTEM disk only&#xa;the data disk (/mnt/data -&gt; MongoDB) is preserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="348" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="k_apply" value="5. Re-provision from the Dashboard&#xa;-&gt; node reboots into the new baked image -&gt; fresh k3s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="444" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="k_redeploy" value="6. ArgoCD re-deploys the app from git  (app-of-apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="540" width="470" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="k_verify" value="7. Verify  app :80  +  ArgoCD UI :30080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="626" width="470" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="k_e1" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="k_bump" target="k_build" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="k_e2" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="k_build" target="k_reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="k_e3" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="k_reg" target="k_stop" edge="1">
